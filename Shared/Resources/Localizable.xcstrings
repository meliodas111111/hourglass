    "One-time payment. No subscription. Purchases are tied to your Apple ID and restored on all your devices.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmalige Zahlung. Kein Abo. Käufe sind an deine Apple-ID gebunden und auf all deinen Geräten wiederherstellbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pago único. Sin suscripción. Las compras se vinculan a tu ID de Apple y se restauran en todos tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paiement unique. Sans abonnement. Les achats sont liés à votre identifiant Apple et restaurés sur tous vos appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार भुगतान। कोई सदस्यता नहीं। खरीदारी आपकी Apple ID से जुड़ी होती है और आपके सभी डिवाइस पर बहाल होती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento unico. Nessun abbonamento. Gli acquisti sono legati al tuo ID Apple e ripristinati su tutti i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回限りの支払い。サブスクリプションではありません。購入はApple IDに紐づき、すべてのデバイスで復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1회 결제. 구독 없음. 구매는 Apple ID에 연결되며 모든 기기에서 복원됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorazowa płatność. Bez subskrypcji. Zakupy są powiązane z Apple ID i przywracane na wszystkich urządzeniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento único. Sem assinatura. As compras ficam vinculadas ao seu ID Apple e são restauradas em todos os seus dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разовый платёж. Без подписки. Покупка привязана к вашему Apple ID и восстанавливается на всех устройствах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek seferlik ödeme. Abonelik yok. Satın alımlar Apple Kimliğinize bağlıdır ve tüm cihazlarınızda geri yüklenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性付款，非订阅。购买与您的 Apple ID 绑定，可在所有设备上恢复。"
          }
        }
      }
    },
    "Open the app and flip the hourglass.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die App und dreh die Sanduhr um."
