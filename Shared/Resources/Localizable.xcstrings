            "value": "%1$@ 종료. 다음: %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zakończone. Następnie: %2$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ terminou. Próximo: %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — завершено. Далее: %2$@"
          }
