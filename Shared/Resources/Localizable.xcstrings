    "No account, no server: your timers stay on this device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto, kein Server: Deine Timer bleiben auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta ni servidor: tus temporizadores se quedan en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni compte ni serveur : vos minuteurs restent sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई खाता नहीं, कोई सर्वर नहीं: आपके टाइमर इसी डिवाइस पर रहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account, nessun server: i tuoi timer restano su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントもサーバーも不要。タイマーはこのデバイスにのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정도 서버도 없습니다. 타이머는 이 기기에만 저장됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez konta i serwera: Twoje minutniki zostają na tym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta, sem servidor: seus timers ficam neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без аккаунта и сервера: ваши таймеры хранятся только на этом устройстве."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap yok, sunucu yok: zamanlayıcılarınız bu cihazda kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账户，无需服务器：您的计时器只保存在本设备上。"
          }
        }
      }
    },
