    "Your saved timers, sequences and settings will be deleted. Purchases are not affected.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gespeicherten Timer, Sequenzen und Einstellungen werden gelöscht. Käufe sind nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán tus temporizadores, secuencias y ajustes guardados. Las compras no se ven afectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos minuteurs, séquences et réglages seront supprimés. Les achats ne sont pas affectés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सहेजे गए टाइमर, अनुक्रम और सेटिंग्स हटा दिए जाएँगे। खरीदारी प्रभावित नहीं होगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I timer salvati, le sequenze e le impostazioni verranno eliminati. Gli acquisti non sono interessati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したタイマー、シーケンス、設定は削除されます。購入には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 타이머, 시퀀스, 설정이 삭제됩니다. 구매에는 영향이 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane minutniki, sekwencje i ustawienia zostaną usunięte. Nie dotyczy to zakupów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus timers, sequências e ajustes salvos serão apagados. As compras não são afetadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые таймеры, последовательности и настройки будут удалены. Покупки не затрагиваются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı zamanlayıcılarınız, dizileriniz ve ayarlarınız silinecek. Satın alımlar etkilenmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您保存的计时器、序列和设置将被删除。购买项目不受影响。"
          }
        }
      }
    },
