    "Alarms ring even in Silent mode and with Focus on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wecker klingeln auch im Stumm- und Fokusmodus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alarmas suenan incluso en modo silencio y con un modo de concentración activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alarmes sonnent même en mode silencieux et avec un Mode de concentration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म साइलेंट मोड और फ़ोकस चालू होने पर भी बजते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sveglie suonano anche in modalità silenziosa e con la modalità Full immersion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームは消音モードや集中モードでも鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무음 모드나 집중 모드에서도 알람이 울립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmy dzwonią nawet w trybie cichym i przy włączonym skupieniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alarmes tocam mesmo no modo silencioso e com o Foco ativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигналы звучат даже в беззвучном режиме и при включённом фокусе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmlar sessiz modda ve Odak açıkken bile çalar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使在静音模式或专注模式下，闹钟也会响起。"
          }
        }
      }
    },
