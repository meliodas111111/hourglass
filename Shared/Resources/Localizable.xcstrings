      }
    },
    "A one-time purchase that keeps Hourglass independent.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einmaliger Kauf, der Sanduhr unabhängig hält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una compra única que mantiene Reloj de arena independiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un achat unique qui garde Sablier indépendant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार की खरीदारी जो ऐप को स्वतंत्र रखती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un acquisto unico che mantiene Clessidra indipendente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "砂時計の開発を支える1回限りの購入です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모래시계를 독립적으로 유지하는 1회 구매입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorazowy zakup, który pozwala Klepsydrze pozostać niezależną."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma compra única que mantém a Ampulheta independente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разовая покупка, которая помогает «Песочным часам» оставаться независимыми."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kum Saati'nin bağımsız kalmasını sağlayan tek seferlik satın alma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性购买，支持沙漏独立发展。"
          }
        }
      }
    },
