    "Allow alerts so the timer can ring when it ends — even when the app is closed, the phone is locked or in Silent mode.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Hinweise, damit der Timer am Ende klingelt — auch wenn die App geschlossen, das Telefon gesperrt oder stumm ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite los avisos para que el temporizador suene al terminar, incluso con la app cerrada, el teléfono bloqueado o en silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les alertes pour que le minuteur sonne à la fin — même app fermée, téléphone verrouillé ou en mode silencieux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलर्ट की अनुमति दें ताकि टाइमर खत्म होने पर बजे — ऐप बंद हो, फ़ोन लॉक हो या साइलेंट मोड में हो तब भी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti gli avvisi così il timer suonerà alla fine — anche con l'app chiusa, il telefono bloccato o in modalità silenziosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を許可すると、アプリを閉じていても、ロック中や消音モードでもタイマー終了時に鳴ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 허용하면 앱이 닫혀 있거나 잠금 상태 또는 무음 모드에서도 타이머 종료 시 울립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na powiadomienia, aby minutnik zadzwonił po zakończeniu — nawet gdy aplikacja jest zamknięta, telefon zablokowany lub wyciszony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita alertas para que o timer toque ao terminar — mesmo com o app fechado, o telefone bloqueado ou no modo silencioso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите уведомления, чтобы таймер прозвенел по окончании — даже если приложение закрыто, телефон заблокирован или в беззвучном режиме."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama kapalı, telefon kilitli veya sessiz modda olsa bile süre bitince çalması için uyarılara izin verin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许提醒，计时结束时即可响铃——即使应用已关闭、手机已锁定或处于静音模式。"
          }
        }
      }
    },
