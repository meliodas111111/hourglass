    "Alerts are delivered as Time Sensitive notifications.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweise werden als dringende Mitteilungen zugestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos se envían como notificaciones urgentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes sont envoyées comme notifications urgentes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलर्ट समय-संवेदनशील सूचनाओं के रूप में भेजे जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi vengono inviati come notifiche urgenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は「即時通知」として届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 시간 민감 알림으로 전달됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia są dostarczane jako pilne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas são enviados como notificações urgentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигналы приходят как срочные уведомления."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarılar Zamana Duyarlı bildirimler olarak iletilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒将作为时效性通知送达。"
          }
